APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me-to-random-string

DB_DRIVER=pdo_pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=products
DB_USER=app
DB_PASSWORD=secret

JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_TTL=86400

MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

UPLOAD_MAX_SIZE=10485760
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW=60

STORAGE_PATH=/var/www/storage
PUBLIC_STORAGE_URL=http://localhost/storage

CORS_ORIGIN=http://localhost:4200
