{
    "name": "test-sherpa/product-import",
    "description": "Slim + Doctrine product import API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "doctrine/orm": "^3.0",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.8",
        "symfony/cache": "^7.0",
        "symfony/var-exporter": "^7.4",
        "symfony/messenger": "^7.0",
        "symfony/amqp-messenger": "^7.0",
        "phpoffice/phpspreadsheet": "^3.3",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "zircote/swagger-php": "^4.11",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "php tools/phpstan.phar analyse -c phpstan.neon",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
